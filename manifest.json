{
  "manifest_version": 3,
  "name": "Timeline Skipper",
  "version": "1.1.0",
  "description": "타임라인 댓글로 트랙 목록을 만들고, 체크 해제한 구간을 자동으로 건너뜁니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Timeline Skipper",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://chzzk.naver.com/*"],
      "js": ["src/content.js"],
      "css": [
        "src/ui/styles/panel.css",
        "src/ui/styles/header.css",
        "src/ui/styles/menuConfirm.css",
        "src/ui/styles/controls.css",
        "src/ui/styles/progressBar.css",
        "src/ui/styles/trackList.css",
        "src/ui/styles/listArrival.css",
        "src/ui/styles/trackListControls.css",
        "src/ui/styles/quickAdd.css",
        "src/ui/styles/editSheet.css",
        "src/ui/styles/editForm.css",
        "src/ui/styles/timeFields.css",
        "src/ui/styles/commentButton.css",
        "src/ui/styles/floating.css",
        "src/ui/styles/floatingHandle.css",
        "src/ui/styles/floatingMarquee.css",
        "src/ui/styles/floatingPip.css",
        "src/ui/styles/powerOff.css",
        "src/ui/styles/toast.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/ui/styles/tokens.youtube.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "css": ["src/ui/styles/tokens.chzzk.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/modulePaths.js", "src/wiring.js", "src/trackActions.js", "src/playbackActions.js","src/core/*/*.js", "src/adapters/*.js", "src/ui/*.js", "src/ui/parts/*.js", "src/ui/parts/edit/*.js", "src/ui/styles/*.css"],
      "matches": ["https://www.youtube.com/*", "https://chzzk.naver.com/*"]
    }
  ]
}
