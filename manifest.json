{
  "manifest_version": 3,
  "name": "타임라인 스킵",
  "version": "0.1.0",
  "description": "타임라인 댓글로 트랙 목록을 만들고, 체크 해제한 구간을 자동으로 건너뜁니다.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/ui/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/wiring.js", "src/trackActions.js", "src/core/*.js", "src/adapters/*.js", "src/ui/*.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
